# 复制本文件为 .env 并填入自己的 Key
# 说明:真实的 .env 已被 .gitignore 忽略,不会进入版本库

# ── 必填 ──
# 阿里云百炼(DashScope):文本向量化 text-embedding-v3 + 图片描述 qwen3-vl-plus
# 获取地址:https://bailian.console.aliyun.com/
BAILIAN_API_KEY=

# ── 可选(当前 src/ 未引用,保留给后续联网问答/生成) ──
DEEPSEEK_API_KEY=

# ── 可选调优 ──
# 精排模型的 HuggingFace 镜像(默认已在 src/retrieve_hybrid.py 里设为 hf-mirror)
# HF_ENDPOINT=https://hf-mirror.com
